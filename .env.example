# ─── WhatsApp (no token needed — bot links via QR code on first run) ──────────
# Scan the QR code printed in the terminal when you run the bot for the first time.
# Session is saved to data/.wwebjs_auth/ automatically.

# ─── WeedeN REST API ──────────────────────────────────────────────────────────
# Base URL of your Odoo instance (no trailing slash)
ODOO_URL=https://your-odoo-instance.com
# Bearer token for POST /api/client/register
ODOO_API_TOKEN=your_api_token_here
# HEADER for POST /api/client/register
ODOO_HEADER=your_header_here
# ─── Odoo Purchase Webhook ────────────────────────────────────────────────────
# Secret to protect the webhook endpoint (X-API-Key header)
WEBHOOK_SECRET=your_strong_secret_here
# Port for the Express webhook server (default 8080)
WEBHOOK_PORT=8080
# Delay before sending thank-you message after purchase (seconds, default 600 = 10 min)
THANK_YOU_DELAY_SECONDS=600
# Delay before sending retention message (seconds, default 86400 = 24h)
RETENTION_DELAY_SECONDS=86400

# ─── Manager Notifications ────────────────────────────────────────────────────
# WhatsApp number of the manager (digits only, with country code, e.g. 66812345678)
MANAGER_PHONE=66812345678
MANAGER_WA_ID=+66812345678
MANAGER_WORK_START=10
MANAGER_WORK_END=18

# ─── AI Assistant (Claude) — for manager chat escalation ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── AI Help Assistant (Gemini) ───────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── External Links ───────────────────────────────────────────────────────────
SOCIALS_URL=https://your-socials-landing.com
RECIPE_URL=https://your-recipe-partner.com

# ─── Meta Conversions API (Ads Manager) ──────────────────────────────────────
# Pixel ID: Meta Ads Manager → Events Manager → your Pixel → Settings
META_PIXEL_ID=123456789012345
# Access Token: Events Manager → your Pixel → Settings → Conversions API → Generate access token
META_ACCESS_TOKEN=your_meta_capi_access_token_here

# ─── Twilio (SMS OTP) ─────────────────────────────────────────────────────────
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+12345678901

# ─── BotsAPI (optional — for multi-channel binding) ──────────────────────────
BOTS_API_URL=http://localhost:8000
BOTS_API_KEY=your_bots_api_key
